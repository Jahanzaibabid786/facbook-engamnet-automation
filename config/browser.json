{
  "browser": {
    "type": "chrome",
    "headless": false,
    "arguments": [
      "--disable-blink-features=AutomationControlled",
      "--disable-dev-shm-usage"
    ],
    "facebook_url": "https://www.facebook.com",
    "login_timeout": 300,
    "validation": {
      "retry_attempts": 3,
      "retry_delay": 5
    }
  }
}
